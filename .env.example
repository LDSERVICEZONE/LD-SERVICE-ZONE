# ==============================================================================
# LD SERVICE ZONE — Environment Configuration
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=8443
LD_API_PORT=8787
PUBLIC_APP_URL=http://localhost:8443
CORS_ORIGIN=http://localhost:8443

# Demo Mode (Set to false for real production operations)
DEMO_MODE=true

# ==============================================================================
# Supabase Configuration (Auth & PostgreSQL Database)
# ==============================================================================
# Optional PostgreSQL connection URI for future relational migrations.
# The current API uses Supabase REST/PostgREST with SUPABASE_SERVICE_ROLE_KEY.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Project API credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"
# Server-only service role key (NEVER expose to browser/frontend)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# Supabase is required for local, preview, and production environments.
DATA_STORE="supabase"
SUPABASE_STATE_TABLE="platform_state"
SUPABASE_STORAGE_BUCKET="private-documents"

# ==============================================================================
# Security & Cryptography
# ==============================================================================
# Secret key used for AES-256-GCM encryption of Aadhaar, PAN, and Bank data at rest.
# Must be a strong, unpredictable random string (e.g., generate with: openssl rand -hex 32)
DATA_ENCRYPTION_KEY="your_secure_32_byte_encryption_key_here"

# Seed Admin Credentials (created automatically on first boot if no admin exists)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your_secure_admin_password"

# ==============================================================================
# Payment Gateway (Razorpay)
# Leave blank to use local demo payment mode during development
# ==============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ==============================================================================
# Mobile & DTH Recharge Provider (Pay2All)
# ==============================================================================
PAY2ALL_API_KEY=""

# ==============================================================================
# Google Sheets Synchronization (Optional)
# Syncs users, applications, payments, and audit logs to Google Sheets
# ==============================================================================
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SHEET_TAB_USERS="Users"
GOOGLE_SHEET_TAB_APPLICATIONS="Applications"
GOOGLE_SHEET_TAB_PAYMENTS="Payments"
GOOGLE_SHEET_TAB_AUDIT="AuditLogs"
