generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { RETAILER ADMIN }
enum ApplicationStatus { PAYMENT_PENDING SUBMITTED PROCESSING ACCEPTED REJECTED COMPLETED }
enum KycStatus { PENDING UNDER_REVIEW APPROVED REJECTED CORRECTION_REQUIRED }
enum PaymentStatus { CREATED PAID FAILED REFUNDED }
enum WalletEntryType { CREDIT DEBIT REVERSAL ADJUSTMENT }
enum RechargeStatus { PENDING SUCCESS FAILED REFUNDED }

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  mobile       String?  @unique
  passwordHash String?
  name         String
  businessName String?
  role         UserRole @default(RETAILER)
  active       Boolean  @default(true)
  emailVerifiedAt DateTime?
  mobileVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  retailer     RetailerProfile?
  sessions     Session[]
  applications Application[]
  wallets      Wallet[]
  auditLogs    AuditLog[]
  tickets      SupportTicket[]
}

model RetailerProfile {
  id        String @id @default(cuid())
  userId    String @unique
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model ServiceCategory {
  id       String @id @default(cuid())
  name     String @unique
  active   Boolean @default(true)
  services Service[]
}

model Service {
  id                String @id @default(cuid())
  categoryId        String
  category          ServiceCategory @relation(fields: [categoryId], references: [id])
  name              String
  slug              String @unique
  description       String?
  customerPrice     Decimal @db.Decimal(12,2)
  retailerCommission Decimal @db.Decimal(12,2)
  processingDays    Int?
  active            Boolean @default(true)
  formSchema        Json?
  requiredDocuments Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  applications      Application[]
  @@index([categoryId, active])
}

model Application {
  id          String @id @default(cuid())
  userId      String
  serviceId   String
  status      ApplicationStatus @default(SUBMITTED)
  amount      Decimal @db.Decimal(12,2)
  customerData Json
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id])
  service     Service @relation(fields: [serviceId], references: [id])
  documents   ApplicationDocument[]
  history     ApplicationStatusHistory[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ApplicationDocument {
  id            String @id @default(cuid())
  applicationId String
  storageKey    String
  originalName  String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationStatusHistory {
  id            String @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  actorUserId   String?
  createdAt     DateTime @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
}

model KycProfile {
  id              String @id @default(cuid())
  userId          String @unique
  status          KycStatus @default(PENDING)
  encryptedData   String?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       KycDocument[]
  reviews         KycReview[]
}

model KycDocument {
  id          String @id @default(cuid())
  kycId       String
  type        String
  storageKey  String
  originalName String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  kyc          KycProfile @relation(fields: [kycId], references: [id], onDelete: Cascade)
}

model KycReview {
  id          String @id @default(cuid())
  kycId       String
  status      KycStatus
  note        String?
  reviewerId  String?
  createdAt   DateTime @default(now())
  kyc         KycProfile @relation(fields: [kycId], references: [id], onDelete: Cascade)
}

model Wallet {
  id        String @id @default(cuid())
  userId    String @unique
  balance   Decimal @default(0) @db.Decimal(14,2)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    WalletLedger[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletLedger {
  id          String @id @default(cuid())
  walletId    String
  type        WalletEntryType
  amount      Decimal @db.Decimal(14,2)
  reference   String @unique
  description String?
  createdAt   DateTime @default(now())
  wallet      Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId, createdAt])
}

model Payment {
  id          String @id @default(cuid())
  userId      String
  provider    String
  providerOrderId String? @unique
  providerPaymentId String? @unique
  amount      Decimal @db.Decimal(14,2)
  status      PaymentStatus @default(CREATED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      PaymentEvent[]
  @@index([userId, createdAt])
}

model PaymentEvent {
  id             String @id @default(cuid())
  paymentId      String
  providerEventId String @unique
  eventType      String
  payload        Json
  createdAt      DateTime @default(now())
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Refund {
  id              String @id @default(cuid())
  paymentId       String
  providerRefundId String? @unique
  amount          Decimal @db.Decimal(14,2)
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RechargeTransaction {
  id             String @id @default(cuid())
  userId         String
  provider       String
  externalRef    String? @unique
  mobile         String
  operator       String
  circle         String?
  amount         Decimal @db.Decimal(12,2)
  status         RechargeStatus @default(PENDING)
  commission     Decimal @default(0) @db.Decimal(12,2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  statuses       RechargeStatusHistory[]
  @@index([userId, createdAt])
}

model RechargeStatusHistory {
  id           String @id @default(cuid())
  transactionId String
  status       RechargeStatus
  payload      Json?
  createdAt    DateTime @default(now())
  transaction  RechargeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model CommissionRule {
  id        String @id @default(cuid())
  serviceId String?
  operator  String?
  rate      Decimal @db.Decimal(8,4)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  channel   String
  type      String
  status    String
  payload   Json
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String @id @default(cuid())
  userId    String
  subject   String
  category  String
  priority  String @default("NORMAL")
  status    String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id])
  messages  SupportMessage[]
}

model SupportMessage {
  id        String @id @default(cuid())
  ticketId  String
  senderId  String?
  body      String
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt])
}
